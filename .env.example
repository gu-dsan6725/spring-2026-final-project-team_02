# ============================================================================
# Policy Memo Agent — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# ============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# Groq — research agent, HERALD Tier 2 judge, revision agent
# Free tier: 14,400 req/day on Llama 3.3 70B
# Get key: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini — web search (grounding)
# Free tier: 1,500 req/day
# Get key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Optional: Observability ───────────────────────────────────────────────────

# Braintrust — LLM call tracing and evaluation logging
# Free hobby tier available. App runs fine without this.
# Get key: https://braintrust.dev → Settings → API Keys
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=policy-memo-agent

# OpenTelemetry — ship traces to Jaeger, Honeycomb, Grafana Tempo, etc.
# Leave blank to print traces to stderr in development.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=policy-memo-agent

# ── Optional: Additional data sources ────────────────────────────────────────

# GovInfo (US Congressional/GAO reports)
# Get key: https://api.govinfo.gov/docs/ → Sign Up (free)
GOVINFO_API_KEY=

# FRED (Federal Reserve economic data)
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=

# Brave Search (alternative to Gemini for web search)
# Get key: https://brave.com/search/api/ (free: 2,000 req/month)
BRAVE_SEARCH_API_KEY=

# ── Optional: Python backend (Tier 1 NLI) ────────────────────────────────────
# Only needed if running the FastAPI backend for local NLI inference.
# Without this, HERALD skips Tier 1 and starts at Tier 2 (Groq).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policy_memo
REDIS_URL=redis://localhost:6379

# HuggingFace model ID (downloaded automatically on first run, ~900MB)
HF_MODEL_PATH=microsoft/deberta-v3-large-mnli

# Optional: path to a pre-exported ONNX model dir for faster CPU inference.
NLI_ONNX_MODEL_PATH=

# ── Agent configuration ───────────────────────────────────────────────────────
MAX_TOOL_CALLS=25
MAX_RESEARCH_TOKENS=50000
MAX_REVISION_ATTEMPTS=2
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=3000
