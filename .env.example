# ============================================================================
# Policy Memo Agent — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# See SETUP.md for instructions on obtaining each key.
# ============================================================================

# ── Research Agent (required) ─────────────────────────────────────────────────
# Groq API key — get from https://console.groq.com (free tier: 14,400 req/day)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Search (required) ─────────────────────────────────────────────────────
# Brave Search API key — https://brave.com/search/api/ (free: 2,000 req/month)
BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (optional — only for HERALD Tier 2/3 LLM judge) ────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Braintrust Observability (optional) ──────────────────────────────────────
# https://braintrust.dev — free hobby tier. App runs without this.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=policy-memo-agent

# ── OpenTelemetry (optional) ─────────────────────────────────────────────────
# Set to ship traces to Jaeger, Tempo, Honeycomb, etc.
# If not set, traces are printed to stderr in development.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=policy-memo-agent

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policy_memo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Additional Data Sources (optional) ───────────────────────────────────────
# GovInfo (US Congressional/GAO reports) — https://api.govinfo.gov/docs/
GOVINFO_API_KEY=

# FRED (Federal Reserve economic data) — https://fred.stlouisfed.org/docs/api/
FRED_API_KEY=

# ── HERALD Tier 1: NLI Model ─────────────────────────────────────────────────
# HuggingFace model ID (downloaded automatically on first run, ~900MB)
HF_MODEL_PATH=microsoft/deberta-v3-large-mnli

# Optional: path to a pre-exported ONNX model dir for faster CPU inference.
# See SETUP.md "NLI Model Setup" for export instructions.
NLI_ONNX_MODEL_PATH=

# ── Agent Configuration ───────────────────────────────────────────────────────
AGENT_MODEL=llama-3.3-70b-versatile
MAX_TOOL_CALLS=25
MAX_RESEARCH_TOKENS=50000
MAX_REVISION_ATTEMPTS=2

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=3000
VERBOSE_TRACING=false
